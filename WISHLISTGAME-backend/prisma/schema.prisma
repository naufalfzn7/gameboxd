generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}


model User {
  id        String     @id @default(uuid())
  email     String     @unique
  newEmail  String?    @unique
  password  String
  name      String?
  role      Role       @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isActive  Boolean    @default(false)
  reviews   Review[] 
  wishlists Wishlist[] 
  favorites Favorite[]
}


model Review {
  id        String     @id @default(uuid())
  rating    Int
  comment   String
  userId    String
  gameId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
}

enum WishlistStatus {
  PENDING
  PURCHASED
  REMOVED
}

model Wishlist {
  id        String     @id @default(uuid())
  userId    String
  gameId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  status   String     @default("PENDING")

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, gameId])
}


model Favorite {
  id        String     @id @default(uuid())
  userId    String
  gameId    Int
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, gameId])
}