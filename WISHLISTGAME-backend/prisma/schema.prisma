generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Genre {
  ACTION
  ADVENTURE
  RPG
  STRATEGY
  SIMULATION
  SPORTS
  PUZZLE
  HORROR
  MMO
  PLATFORMER
}
model Game {
  id          String     @id @default(uuid())
  title       String
  genre       Genre[]
  rating      Int        @default(0)
  releaseDate DateTime
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  urlPicture  String?
  description String?
  developer   String?
  publisher   String?

  reviews     Review[]
  wishlists   Wishlist[]
  favorites   Favorite[]
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  newEmail  String?    @unique
  password  String
  name      String?
  role      Role       @default(USER)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  isActive  Boolean    @default(false)
  reviews   Review[] 
  wishlists Wishlist[] 
  favorites Favorite[]
}


model Review {
  id        String     @id @default(uuid())
  rating    Int
  comment   String
  userId    String
  gameId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])
}

enum WishlistStatus {
  PENDING
  PURCHASED
  REMOVED
}

model Wishlist {
  id        String     @id @default(uuid())
  userId    String
  gameId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  status   String     @default("PENDING")

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
}


model Favorite {
  id        String     @id @default(uuid())
  userId    String
  gameId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id])
  game Game @relation(fields: [gameId], references: [id])

  @@unique([userId, gameId])
}